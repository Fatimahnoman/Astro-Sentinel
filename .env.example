# ============================================================================
#  ASTRO-SENTINEL — Environment Variables
#  Copy to .env.local and fill in only what you need. The app runs fully offline
#  without any of these — they only unlock the online NASA / Multi-LLM paths.
# ============================================================================

# --- NASA Space Weather (DONKI is OPEN ACCESS — no key required) ----------
NASA_API_KEY=
NASA_DONKI_BASE_URL=

# --- AI Doctor: Multi-LLM Online Chain (OpenRouter → Gemini → Grok) -------
# Optional. Without these, the on-device Offline Edge Engine (12 protocols)
# answers every query with zero latency and no external calls.
# Note: OpenRouter account must hold credits for paid models — free models
# like google/gemma-4-31b-it:free work out of the box.
# gsk_* keys are auto-detected as Groq (api.groq.com) — no xAI key needed.
# Get keys: https://openrouter.ai/keys · https://ai.google.dev · https://console.x.ai · https://console.groq.com
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
